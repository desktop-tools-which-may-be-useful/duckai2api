# duckai2api-rust 配置样例（.env 与进程环境变量同构；所有键在代码中均有消费点）
# 复制为 .env 后按需修改：cp .env.example .env
#
# 存储语义（sqlite，见 DUCKAI_DB_PATH）：
#   - 密钥/管理口令/可变设置在库中持久化；env 只提供**首次引导值**，库中已有数据以库为准。
#   - 旧名 DUCKAI_API_KEY / DUCKAI_ADMIN_PASSWORD 仍被接受为默认值（兼容既有部署）。

# ---------------------------------------------------------------- 存储
# sqlite 库路径（默认 data/duckai.db，文件权限强制 0600；:memory: = 进程内不落盘）
DUCKAI_DB_PATH=data/duckai.db

# ---------------------------------------------------------------- 上游 / 协议（首次启动引导入库）
# 上游 BASE（默认 https://duck.ai）；状态、挑战与对话端点均相对它拼接
DUCKAI_BASE=https://duck.ai
# 接入模式：auto | http | browser（默认 auto；纯 HTTP 为默认主路径，browser 仅在
# 以 browser feature 编译且显式/auto 降级时启用）
DUCKAI_UPSTREAM=auto
# 运维捕获的 x-vqd-hash-1 注入（挑战求解退化链第 2 级，带 10 分钟 TTL；留空=不注入）
DUCKAI_VQD_OVERRIDE=
# 默认模型（客户端未指定时使用；未知模型本地 404）
DUCKAI_MODEL=gpt-5.6-luna
# 是否每次请求新开会话（true=不复用 conversationId/messageId 粘性）
DUCKAI_NEW_CHAT=false

# ---------------------------------------------------------------- 代理 / 出口
# 代理池：逗号分隔，支持 http/https/socks5；为空=直连（真正配置到传输层，非死配置）
DUCKAI_PROXIES=
# 单代理（遗留变量名兼容；与 DUCKAI_PROXIES 合并）
DUCKAI_PROXY=

# ---------------------------------------------------------------- 对外 API
# 默认/引导 API 密钥：仅当库内 api_keys 表为空时导入为第一把；之后密钥增删走 WebUI（库为准）。
# 非回环绑定（DUCKAI_BIND）启动时必须至少有一把可用密钥，否则启动失败（fail-fast）。
DUCKAI_DEFAULT_API_KEY=
# 监听端口（默认 8080）
PORT=8080
# 监听地址（默认 127.0.0.1；改为非回环需要库内至少一把可用 API key）
DUCKAI_BIND=127.0.0.1
# 全局并发上限（默认 8；超过时 API 层直接 429 + retry-after；首次启动引导入库）
DUCKAI_MAX_CONCURRENCY=8

# ---------------------------------------------------------------- WebUI / 管理
# 默认管理口令：库内无自定义口令时生效；WebUI 改口令后写入库内并遮蔽此默认值（救援=删库内 admin_password 行）。
# 为空=WebUI 只读且仅回环可访问，写操作恒 403
DUCKAI_DEFAULT_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 浏览器模式
# Chrome/Chromium 可执行文件路径（browser feature 编译时使用；留空=自动探测）
DUCKAI_CHROME_PATH=

# ---------------------------------------------------------------- 日志
# tracing 日志过滤（如 info / duckai_api=debug）
RUST_LOG=info

# ---------------------------------------------------------------- 兼容旧名（等价于 DEFAULT_ 前缀名，勿同时设置）
# DUCKAI_API_KEY=
# DUCKAI_ADMIN_PASSWORD=
