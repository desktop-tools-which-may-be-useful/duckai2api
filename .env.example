# duckai2api-rust 配置样例（.env 与进程环境变量同构；所有键在代码中均有消费点）
# 复制为 .env 后按需修改：cp .env.example .env

# ---------------------------------------------------------------- 上游 / 协议
# 上游 BASE（默认 https://duck.ai）；状态、挑战与对话端点均相对它拼接
DUCKAI_BASE=https://duck.ai
# 接入模式：auto | http | browser（默认 auto；纯 HTTP 为默认主路径，browser 仅在
# 以 browser feature 编译且显式/auto 降级时启用）
DUCKAI_UPSTREAM=auto
# 运维捕获的 x-vqd-hash-1 注入（挑战求解退化链第 2 级，带 10 分钟 TTL；留空=不注入）
DUCKAI_VQD_OVERRIDE=
# 默认模型（客户端未指定时使用；未知模型本地 404）
DUCKAI_MODEL=gpt-5.6-luna
# 是否每次请求新开会话（true=不复用 conversationId/messageId 粘性）
DUCKAI_NEW_CHAT=false

# ---------------------------------------------------------------- 代理 / 出口
# 代理池：逗号分隔，支持 http/https/socks5；为空=直连（真正配置到传输层，非死配置）
DUCKAI_PROXIES=
# 单代理（遗留变量名兼容；与 DUCKAI_PROXIES 合并）
DUCKAI_PROXY=

# ---------------------------------------------------------------- 对外 API
# API 密钥：非空时强制 Bearer 鉴权；为空时仅允许回环绑定（否则启动失败，fail-fast）
DUCKAI_API_KEY=
# 监听端口（默认 8080）
PORT=8080
# 监听地址（默认 127.0.0.1；改为非回环需要同时设置非空 DUCKAI_API_KEY）
DUCKAI_BIND=127.0.0.1
# 全局并发上限（默认 8；超过时 API 层直接 429 + retry-after）
DUCKAI_MAX_CONCURRENCY=8

# ---------------------------------------------------------------- WebUI / 管理
# 管理口令：非空=登录换会话 cookie；为空=WebUI 只读且仅回环可访问，写操作恒 403
DUCKAI_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 浏览器模式
# Chrome/Chromium 可执行文件路径（browser feature 编译时使用；留空=自动探测）
DUCKAI_CHROME_PATH=

# ---------------------------------------------------------------- 日志
# tracing 日志过滤（如 info / duckai_api=debug）
RUST_LOG=info
